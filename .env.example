# Local dev: config.settings.dev — leave unset (or set to config.settings.prod) in
# production so the code-level default fails safe if this var is ever missing.
DJANGO_SETTINGS_MODULE=config.settings.dev
SECRET_KEY=
ACCESS_TOKEN_SECRET=
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=
PAYMONGO_SECRET_KEY=
PAYMONGO_PUBLIC_KEY=
PAYMONGO_WEBHOOK_SECRET=
ALLOWED_HOSTS=
CORS_ALLOWED_ORIGINS=
